FROM python:3.12-slim
WORKDIR /app

# Install system deps + Ollama
RUN apt-get update && apt-get install -y \
    libpq-dev gcc curl zstd tesseract-ocr \
    && curl -fsSL https://ollama.com/install.sh | sh \
    && rm -rf /usr/local/lib/ollama/cuda_v12 \
              /usr/local/lib/ollama/cuda_v13 \
              /usr/local/lib/ollama/rocm \
              /usr/local/lib/ollama/vulkan \
    && rm -rf /var/lib/apt/lists/*

# dramatiq-pg pins tenacity<6, which conflicts with llama-index's tenacity>=8.2.
# Install dramatiq-pg without its dependency constraints (dramatiq, tenacity,
# sqlalchemy, psycopg2 are all pinned in requirements.txt).
RUN pip install --no-cache-dir --no-deps dramatiq-pg==0.8.0

# Install remaining Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000 11434
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
