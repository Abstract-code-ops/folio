{
  "name": "Folio Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Next.js" },
    "8000": { "label": "FastAPI" }
  },
  "postCreateCommand": "node --version && npm install -g reasonix@next",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "charliermarsh.ruff"
      ]
    }
  }
}